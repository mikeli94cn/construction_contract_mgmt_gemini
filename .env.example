# Copy to .env and provide secure secrets before running docker compose
CCM_DB_NAME=ccm_db
CCM_DB_USER=ccm_app
CCM_DB_PASSWORD=replace_with_strong_db_password
CCM_DB_ROOT_PASSWORD=replace_with_strong_root_password
CCM_DB_PORT=3306
CCM_JWT_SECRET=replace_with_at_least_32_byte_base64_or_ascii_secret_key_for_hmac_sha256
CCM_BOOTSTRAP_ADMIN_PASSWORD=replace_with_initial_admin_password
